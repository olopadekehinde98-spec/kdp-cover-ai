generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  clerkId       String   @unique
  email         String   @unique
  name          String?
  imageUrl      String?
  plan          Plan     @default(FREE)
  // Legacy Stripe fields (kept so existing rows don't break)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  stripePriceId        String?

  // Lemon Squeezy (kept so existing rows don't break)
  lsCustomerId         String?  @unique
  lsSubscriptionId     String?  @unique
  lsVariantId          String?

  // Paystack (kept so existing rows don't break)
  paystackCustomerId   String?
  paystackSubCode      String?  @unique
  paystackEmailToken   String?
  paystackPlanCode     String?

  // Flutterwave (kept so existing rows don't break)
  flwCustomerId        String?
  flwSubscriptionId    String?  @unique
  flwPlanId            String?

  // Paddle
  paddleCustomerId     String?  @unique
  paddleSubId          String?  @unique
  paddlePriceId        String?

  // Referral system
  referralCode         String?  @unique  // user's own code to share
  referredByCode       String?           // code they used when signing up
  referralDiscountPct  Int      @default(0)  // discount applied to first month (%)
  referralPaidOut      Boolean  @default(false)
  subscriptionStatus   String?  @default("inactive")
  generationsUsed      Int      @default(0)
  generationsLimit     Int      @default(3)
  isBanned             Boolean  @default(false)
  isAdmin              Boolean  @default(false)
  ipAddress            String?
  lastSeenAt           DateTime?
  newsletterOptIn      Boolean  @default(true)
  lastNewsletterAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  covers             Cover[]
  sessions           UserSession[]
  paymentSubmissions PaymentSubmission[]
  affiliateProfile   AffiliateProfile?
  siteRatings        SiteRating[]

  @@index([clerkId])
  @@index([email])
}

model Cover {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  title           String
  subtitle        String?
  authorName      String
  genre           String
  prompt          String      @db.Text
  enhancedPrompt  String?     @db.Text
  description     String?     @db.Text
  authorBio       String?     @db.Text
  reviewQuote     String?

  trimSize        String
  pageCount       Int
  paperType       String
  coverType       String

  imageUrl        String?
  pdfUrl          String?
  previewUrl      String?

  spineWidth      Float?
  totalWidthIn    Float?
  totalHeightIn   Float?

  status          CoverStatus @default(PENDING)
  isFlagged       Boolean     @default(false)
  flagReason      String?

  generationCostUsd Float?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  exports         Export[]

  @@index([userId])
  @@index([status])
}

model Export {
  id          String   @id @default(cuid())
  coverId     String
  cover       Cover    @relation(fields: [coverId], references: [id], onDelete: Cascade)
  userId      String

  format      String   // 'pdf' | 'png' | 'jpg'
  url         String
  fileSizeBytes Int?
  downloadCount Int    @default(0)

  createdAt   DateTime @default(now())

  @@index([coverId])
  @@index([userId])
}

model UserSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId    String
  ipAddress   String?
  country     String?
  userAgent   String?
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([userId])
  @@index([deviceId])
}

model SupportTicket {
  id          String        @id @default(cuid())
  userId      String?
  email       String
  subject     String
  message     String        @db.Text
  status      TicketStatus  @default(OPEN)
  adminNotes  String?       @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  messages    SupportMessage[]

  @@index([status])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    String        // 'user' | 'ai' | 'admin'
  content   String        @db.Text
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

model SiteRating {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverId   String?
  rating    Int      // 1-5
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
}

model IpFraudLog {
  id         String   @id @default(cuid())
  ipAddress  String
  userIds    String[]
  emails     String[]
  isBanned   Boolean  @default(false)
  detectedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([ipAddress])
  @@index([isBanned])
}

model AffiliateProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralCode    String   @unique
  totalReferrals  Int      @default(0)
  activeReferrals Int      @default(0)
  totalEarnedUsd  Float    @default(0)
  totalPaidUsd    Float    @default(0)
  bankName        String?
  accountNumber   String?
  accountName     String?
  isActive        Boolean  @default(true)
  joinedAt        DateTime @default(now())

  commissions AffiliateCommission[]
  payouts     AffiliatePayout[]

  @@index([referralCode])
}

model AffiliateCommission {
  id             String           @id @default(cuid())
  affiliateId    String
  affiliate      AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUserId String
  plan           String
  amountUsd      Float
  percentage     Float
  isPaid         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  @@index([affiliateId])
}

model AffiliatePayout {
  id          String           @id @default(cuid())
  affiliateId String
  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amountUsd   Float
  amountNgn   Float
  status      String           @default("PENDING") // PENDING | PAID | REJECTED
  adminNote   String?
  requestedAt DateTime         @default(now())
  paidAt      DateTime?

  @@index([affiliateId])
  @@index([status])
}

enum Plan {
  FREE
  STARTER
  PRO
  AGENCY
}

enum CoverStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model PaymentSubmission {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount        Float
  currency      String           // 'USD' | 'NGN'
  bankUsed      String           // 'Grey Dollar (Lead Bank)' | 'OPay Naira'
  receiptBase64 String           @db.Text
  receiptMime   String           // 'image/jpeg' | 'image/png'
  note          String?          @db.Text

  detectedPlan  String           // plan auto-detected from amount
  status        SubmissionStatus @default(PENDING)
  planAssigned  String?          // plan actually granted after approval
  adminNote     String?

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId])
  @@index([status])
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

// Email capture for non-signed-in visitors (legal opt-in only)
model NewsletterSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  source      String   @default("homepage-popup") // where they signed up
  confirmed   Boolean  @default(false)   // double opt-in via confirm link
  token       String   @unique           // for confirm / unsubscribe links
  lastSentAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([confirmed])
  @@index([email])
}
